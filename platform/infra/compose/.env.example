# Copy values into an ignored .env file or export them from the shell.
# Generate local values with a cryptographically secure password generator.
POSTGRES_DATABASE=konkur
POSTGRES_USER=konkur
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
GRAFANA_ADMIN_USER=admin
